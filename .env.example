# ── Connection Service — environment template ───────────────────────────────
# Copy to `.env` (auto-loaded by Bun) and fill in real values.
# Every variable is OPTIONAL — the defaults below match src/config/constants.ts.

# --- Service ---
PORT=3001

# --- Mongo (single DB per service convention) ---
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=Traderverse-connections

# --- NATS / JetStream (social graph events → feed-data-sync-service) ---
# Same local cluster as user-and-identity-service; anonymous connect is rejected
# (auth callout), so the dev user auth/auth is used by default.
# Docker/remote: nats://host.docker.internal:4222
NATS_URL=nats://localhost:4222
NATS_USER=auth
NATS_PASSWORD=auth

# Publish subjects. The JetStream stream name is FIXED ("SOCIAL", bound to
# `social.>`) and is not configurable.
SOCIAL_FOLLOWED_SUBJECT=social.followed
SOCIAL_UNFOLLOWED_SUBJECT=social.unfollowed
SOCIAL_BLOCKED_SUBJECT=social.blocked
SOCIAL_UNBLOCKED_SUBJECT=social.unblocked
SOCIAL_CIRCLE_CREATED_SUBJECT=social.circle.created
SOCIAL_CIRCLE_DELETED_SUBJECT=social.circle.deleted
SOCIAL_CIRCLE_MEMBER_ADDED_SUBJECT=social.circle.member.added
SOCIAL_CIRCLE_MEMBER_REMOVED_SUBJECT=social.circle.member.removed
